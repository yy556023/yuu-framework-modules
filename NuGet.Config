<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/yy556023/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Yuu.*" />
    </packageSource>
  </packageSourceMapping>
  <!-- 2026-10-31:repo 內不存 token。密碼取自環境變數 NUGET_AUTH_TOKEN(本機:只有 read:packages 的 classic PAT;GitHub Actions:GITHUB_TOKEN;docker build:BuildKit secret nuget_token),見 exvs2ib-server-web .claude/topics/build-run.md「私有 feed 認證」。 -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="yy556023" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
